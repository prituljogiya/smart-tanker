# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=smart_tanker
DB_PASSWORD=change_me
DB_NAME=smart_tanker

# Redis (pub/sub for WebSocket gateway + BullMQ job queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Field-level encryption (AES-256) for PII columns (phone, address, ID numbers)
FIELD_ENCRYPTION_KEY=change_me_32_byte_hex_key

# Payments
RAZORPAY_KEY_ID=change_me
RAZORPAY_KEY_SECRET=change_me
RAZORPAY_WEBHOOK_SECRET=change_me

# Firebase Cloud Messaging (push notifications)
FCM_SERVER_KEY=change_me
